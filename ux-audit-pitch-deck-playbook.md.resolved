    { name: "Form nhập thông tin", score: 50, pass: 9, gap: 9 },
    { name: "Xác nhận giao dịch", score: 50, pass: 5, gap: 5 },
    { name: "Kết quả giao dịch", score: 80, pass: 8, gap: 2 }
  ],
  heuristics: [
    { name: "User Flow", score: 80, detail: "Happy path, back nav" },
    { name: "Error Handling", score: 30, detail: "API errors, validation" },
    { name: "Loading States", score: 40, detail: "Skeleton, spinner, CTA" },
    { name: "Touch & Target", score: 90, detail: "44pt touch targets" },
    { name: "Accessibility", score: 50, detail: "ARIA, focus, motion" },
    { name: "Consistency", score: 60, detail: "Data, masking, dates" }
  ]
}
```

