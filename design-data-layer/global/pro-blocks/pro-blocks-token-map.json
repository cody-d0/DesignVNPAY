{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pro-blocks ↔ DDL token mapping",
  "description": "Map Tailwind class names used in pro-blocks to design-data-layer token paths. Use for review, validation, or codegen.",
  "mappings": {
    "colors": {
      "bg-background": { "ddl": "base.background", "scope": "mode" },
      "text-foreground": { "ddl": "base.foreground", "scope": "mode" },
      "text-muted-foreground": { "ddl": "base.muted-foreground", "scope": "mode" },
      "border-border": { "ddl": "base.border", "scope": "mode" },
      "border-primary": { "ddl": "base.primary", "scope": "mode" },
      "bg-muted": { "ddl": "base.muted", "scope": "mode" },
      "bg-primary": { "ddl": "base.primary", "scope": "mode" },
      "text-primary-foreground": { "ddl": "base.primary-foreground", "scope": "mode" },
      "hover:bg-muted": { "ddl": "base.muted", "scope": "mode" }
    },
    "spacing": {
      "p-2": { "ddl": "spacing.2", "scope": "tailwind" },
      "px-2": { "ddl": "spacing.2", "scope": "tailwind" },
      "p-4": { "ddl": "spacing.4", "scope": "tailwind" },
      "px-4": { "ddl": "spacing.4", "scope": "tailwind" },
      "pt-4": { "ddl": "spacing.4", "scope": "tailwind" },
      "gap-2": { "ddl": "spacing.2", "scope": "tailwind" },
      "gap-4": { "ddl": "spacing.4", "scope": "tailwind" },
      "gap-6": { "ddl": "spacing.6", "scope": "tailwind" },
      "space-y-2": { "ddl": "spacing.2", "scope": "tailwind" },
      "space-y-4": { "ddl": "spacing.4", "scope": "tailwind" },
      "lg:px-6": { "ddl": "container-padding-x", "scope": "custom", "mode": "Desktop" }
    },
    "typography": {
      "text-sm": { "ddl": "text.sm", "scope": "theme" },
      "text-base": { "ddl": "text.base", "scope": "theme" },
      "text-2xl": { "ddl": "text.2xl", "scope": "theme" },
      "text-3xl": { "ddl": "text.3xl", "scope": "theme" },
      "font-bold": { "ddl": "font-weight.bold", "scope": "theme" }
    },
    "radius": {
      "rounded-md": { "ddl": "radius.md", "scope": "theme" },
      "rounded-lg": { "ddl": "radius.lg", "scope": "theme" }
    }
  },
  "resolution_order": ["TailwindCSS", "Theme", "Mode", "Custom"],
  "source_files": {
    "tailwind": "design-data-layer/global/tailwind.json",
    "theme": "design-data-layer/global/theme-default.json",
    "mode_light": "design-data-layer/global/mode-light.json",
    "mode_dark": "design-data-layer/global/mode-dark.json",
    "custom_desktop": "design-data-layer/global/custom-desktop.json",
    "custom_mobile": "design-data-layer/global/custom-mobile.json"
  }
}
