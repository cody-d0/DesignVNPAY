{
  "schema_version": "1",
  "pattern_groups": [
    {
      "id": "selection_mode",
      "name_vi": "Chế độ chọn nhiều",
      "instruction": [
        "Chọn .* (muốn )?xóa",
        "Chọn (danh bạ|người thụ hưởng).* (muốn )?xóa",
        "Chọn item.* (để )?xóa"
      ],
      "counter": [
        "Xóa\\s*\\(\\d+\\)",
        "Xóa \\(\\d+\\)",
        "Delete\\s*\\(\\d+\\)"
      ],
      "action": [
        "Xóa",
        "Xóa \\(\\d+\\)",
        "Delete",
        "Xóa đã chọn"
      ],
      "cancel": [
        "Hủy",
        "Đóng",
        "Cancel"
      ],
      "tags": ["selection_mode", "bulk_action"],
      "inferred_ux": {
        "flow_name_vi": "Xóa nhiều mục (chế độ chọn)",
        "component_rows": [
          { "loai_thanh_phan": "Icon/Button", "mo_ta": "Icon xóa (header, góc phải) — vào chế độ chọn" },
          { "loai_thanh_phan": "Bottom bar", "mo_ta": "Thanh hành động: Xóa (n), Hủy" },
          { "loai_thanh_phan": "Checkbox/Selection", "mo_ta": "Chọn từng item trong danh sách" }
        ],
        "state_hint": "active"
      }
    },
    {
      "id": "confirm_dialog",
      "name_vi": "Hộp thoại xác nhận",
      "instruction": [
        "Bạn có chắc.*xóa",
        "Xác nhận xóa",
        "Thao tác này không thể hoàn tác"
      ],
      "action": [
        "Xóa",
        "Xác nhận",
        "Đồng ý"
      ],
      "cancel": [
        "Hủy",
        "Đóng",
        "Không"
      ],
      "tags": ["confirm_dialog", "destructive"],
      "inferred_ux": {
        "flow_name_vi": "Xác nhận trước khi xóa",
        "component_rows": [
          { "loai_thanh_phan": "Modal/Dialog", "mo_ta": "Hộp thoại xác nhận xóa với nút Xóa (chính) và Hủy" }
        ],
        "state_hint": "default"
      }
    }
  ],
  "inference_rules": [
    {
      "id": "bulk_action_mode",
      "when": {
        "pattern_groups": ["selection_mode"],
        "require_types": ["instruction", "counter", "action"]
      },
      "then": { "use_inferred_from": "selection_mode" },
      "confidence": "high"
    },
    {
      "id": "confirm_dialog_flow",
      "when": {
        "pattern_groups": ["confirm_dialog"],
        "require_types": ["instruction", "action", "cancel"]
      },
      "then": { "use_inferred_from": "confirm_dialog" },
      "confidence": "high"
    }
  ]
}
